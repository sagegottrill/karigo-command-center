  const pr = await prisma.procurementRequest.update({ where: { id: req.params.id }, data: req.body });
  if (req.body.status === 'Procured') {
    await notify('Engineering', 'Part Procured', `Procurement request ${pr.id} (${pr.partName}) marked as Procured.`, 'success');
  }
  res.json(pr);
});

