// --- MESSAGES / CONVERSATIONS ---
app.get('/api/conversations', authenticate, async (_req, res) => {
  res.json(await prisma.conversation.findMany({ orderBy: { updatedAt: 'desc' } }));
});
app.post('/api/conversations', authenticate, async (req, res) => {
  res.json(
    await prisma.conversation.create({
      data: {
        kind: req.body.kind || 'direct',
        name: req.body.name,
        subtitle: req.body.subtitle || '',
        tripId: req.body.tripId || null,
        participants: req.body.participants || [],
        messages: req.body.messages || [],
        unread: 0,
        lastAt: 'now',
      },
    }),
  );
});
app.post('/api/conversations/:id/messages', authenticate, async (req: any, res) => {
  const convo = await prisma.conversation.findUnique({ where: { id: req.params.id } });
  if (!convo) return res.status(404).json({ error: 'Not found' });
  const messages = Array.isArray(convo.messages) ? [...(convo.messages as any[])] : [];
  messages.push({
    id: `m${messages.length + 1}`,
    author: req.body.author || req.user?.name || 'You',
    role: req.body.role || req.user?.role || 'Ops',
    body: req.body.body,
    time: 'now',
    self: true,
  });
  const updated = await prisma.conversation.update({
    where: { id: convo.id },
    data: { messages, unread: 0, lastAt: 'now' },
  });
  res.json(updated);
});
app.patch('/api/conversations/:id', authenticate, async (req, res) => {
  res.json(await prisma.conversation.update({ where: { id: req.params.id }, data: req.body }));
});

